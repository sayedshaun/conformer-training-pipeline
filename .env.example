# Copy to .env and fill in. .env is gitignored; this file is not, so keep it
# free of real values.
#
#   cp .env.example .env && chmod 600 .env

# Mozilla Data Collective API key - required by the `mcv` source only.
# Key: https://mozilladatacollective.com/ (account settings)
# The Bengali Common Voice dataset also needs its terms accepted once at
# https://mozilladatacollective.com/datasets/cmqim44fo00tinr07mbu70eg7
MDC_API_KEY=

# Hugging Face access token - required by the four gated sources:
# shrutilipi, kathbath, indicvoices, vaani.
# Token (needs `read` scope): https://huggingface.co/settings/tokens
# Access must also be requested once per dataset page; approval is automatic
# but not instant.
HF_TOKEN=

# Weights & Biases API key - required only while train.wandb_project is set
# in config.yaml. Set wandb_project: null to train without logging.
# Key: https://wandb.ai/authorize
WANDB_API_KEY=
